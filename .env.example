# Токен бота от @BotFather в Telegram
BOT_TOKEN=1234567890:ABCdefGhIJkLMnNoPQRstuVWXyz

# URL, где размещен index.html (обязательно с https://)
# Примеры:
# GitHub Pages: https://your-nickname.github.io/game-date/
# Vercel: https://game-date.vercel.app/
# GitHub Pages ссылка на твое приложение:
WEBAPP_URL=https://rds0645010.github.io/duo-game-date/

# Твой Telegram User ID (узнать у бота @userinfobot), куда бот перешлет её выбор
ORGANIZER_CHAT_ID=123456789

# ── YouTube без регистрации и cookies ──────────────────────────────────────
# Бот сам поднимает Cloudflare WARP (usque) и качает YouTube через него.
# WARP работает только для YouTube, TikTok/Instagram идут напрямую.
# Отключить: WARP_ENABLED=false
WARP_ENABLED=true

# Максимум одновременных скачиваний. Для 512 МБ RAM рекомендуется 1.
MAX_CONCURRENT_DOWNLOADS=1

# Необязательно: свой прокси для YouTube (http://user:pass@host:port).
# WARP пробуется первым, этот прокси — запасной вариант.
# YOUTUBE_PROXY=

# Необязательно: папки для бинарника usque и его конфига.
# WARP_BIN_DIR=bin
# WARP_DATA_DIR=warp_data
